<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
    <Description>A .NET Roslyn source generator for record-like class semantics, ideal for incremental generator cache key models and C# versions prior to 9.0.</Description>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetAnalyzerDependencyTargetPaths</GetTargetPathDependsOn>
    <GraphifyBootstrapVersion>1.2.0</GraphifyBootstrapVersion>
    <!-- Keep the model navigator's generated Graphify contracts in the analyzer load context. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerDependencies</TargetsForTfmSpecificContentInPackage>
    <ValuifyBootstrapVersion>1.9.1</ValuifyBootstrapVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Run the published generator during this build without adding a dependency on Valuify itself. -->
    <PackageDownload Include="Valuify" Version="[$(ValuifyBootstrapVersion)]" />
    <Analyzer Include="$(NuGetPackageRoot)/valuify/$(ValuifyBootstrapVersion)/analyzers/dotnet/cs/Valuify.dll" />
    <!-- Graphify runs as a build-time analyzer. Keep its dependency versions out of the packaged generator. -->
    <PackageDownload Include="Graphify" Version="[$(GraphifyBootstrapVersion)]" />
    <Analyzer Include="$(NuGetPackageRoot)/graphify/$(GraphifyBootstrapVersion)/analyzers/dotnet/cs/Graphify.dll" />
    <PackageReference Include="MooVC.Syntax.CSharp" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="HashCodeGenerator.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>HashCodeGenerator.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="IgnoreAttributeAnalyzer.Resources.Designer.cs">
      <DependentUpon>IgnoreAttributeAnalyzer.Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="SequenceEqualityComparerGenerator.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SequenceEqualityComparerGenerator.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Visitors\GenerateEqualityOperatorWhenSubjectVisited.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GenerateEqualityOperatorWhenSubjectVisited.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Visitors\GenerateEqualsOverrideWhenSubjectVisited.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GenerateEqualsOverrideWhenSubjectVisited.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Visitors\GenerateEquatableMembersWhenSubjectVisited.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GenerateEquatableMembersWhenSubjectVisited.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Visitors\GenerateGetHashCodeOverrideWhenSubjectVisited.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GenerateGetHashCodeOverrideWhenSubjectVisited.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Visitors\GenerateInequalityOperatorWhenSubjectVisited.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GenerateInequalityOperatorWhenSubjectVisited.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Visitors\GenerateToStringOverrideWhenSubjectVisited.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GenerateToStringOverrideWhenSubjectVisited.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="ValuifyAttributeAnalyzer.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ValuifyAttributeAnalyzer.Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="HashCodeGenerator.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>HashCodeGenerator.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="IgnoreAttributeAnalyzer.Resources.resx">
      <LastGenOutput>IgnoreAttributeAnalyzer.Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="SequenceEqualityComparerGenerator.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SequenceEqualityComparerGenerator.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateEqualityOperatorWhenSubjectVisited.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GenerateEqualityOperatorWhenSubjectVisited.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateEqualsOverrideWhenSubjectVisited.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GenerateEqualsOverrideWhenSubjectVisited.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateEquatableMembersWhenSubjectVisited.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GenerateEquatableMembersWhenSubjectVisited.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateGetHashCodeOverrideWhenSubjectVisited.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GenerateGetHashCodeOverrideWhenSubjectVisited.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateInequalityOperatorWhenSubjectVisited.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GenerateInequalityOperatorWhenSubjectVisited.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateToStringOverrideWhenSubjectVisited.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GenerateToStringOverrideWhenSubjectVisited.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="ValuifyAttributeAnalyzer.Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ValuifyAttributeAnalyzer.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="ResolveAnalyzerDependencies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_AnalyzerDependency Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'
                                      AND '%(ReferenceCopyLocalPaths.Filename)' != '$(AssemblyName)'
                                      AND !$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('Microsoft.CodeAnalysis'))" />
    </ItemGroup>
  </Target>
  <Target Name="GetAnalyzerDependencyTargetPaths" Condition="'$(IncludeAnalyzerDependencies)' == 'true'" DependsOnTargets="ResolveAnalyzerDependencies">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(_AnalyzerDependency)" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
  <Target Name="PackAnalyzerDependencies" DependsOnTargets="ResolveAnalyzerDependencies">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_AnalyzerDependency)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>